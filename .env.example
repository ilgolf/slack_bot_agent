# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Slack — this is a SEPARATE Slack app/bot from piplup-agent (v1), so both can run
# side by side during migration. The bot token is required for either transport.
SLACK_BOT_TOKEN=
# Required only for HTTP Events API at POST /slack/events.
SLACK_SIGNING_SECRET=
# Required for Socket Mode (xapp-..., no public URL/tunnel needed).
SLACK_APP_TOKEN=

# Root directory that local projects are resolved under. `@dev analyze <name>` looks
# for `{PROJECTS_ROOT}/<name>` — a name that doesn't exist there is a reported error,
# never an implicit clone or guess.
PROJECTS_ROOT=~/orca/projects

# Where per-thread git worktrees of confirmed code work are created (one worktree and a
# `bot/<thread>` branch per Slack thread). Keep it outside the projects and outside any
# `.claude` directory: Claude Code refuses every edit under `.claude`.
WORKTREES_ROOT=~/.slack_bot_agent/worktrees

# LLM provider for the analysis agent: fake | anthropic | openai | claude_code | codex
# claude_code / codex delegate read-only analysis to an installed code agent, so they
# need no API key here: sign in to the Claude Code / Codex CLI on this machine instead.
#   claude_code: pip install 'piplup-agent-v2[claude]'
#   codex:       pip install 'piplup-agent-v2[codex]' and put the `codex` CLI on PATH
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Maximum bounded analysis iterations. Duplicate calls and result-size limits
# remain enabled even when this is increased.
AGENT_MAX_TOOL_ITERATIONS=16
# Limits for claude_code / codex runs (the Codex SDK has no turn limit, so it only
# honors the timeout).
AGENT_RUNNER_TIMEOUT_SECONDS=300
AGENT_RUNNER_MAX_TURNS=20

# Code work mode: plan (default) = the agent proposes a plan and the bot writes it after
# `실행`; edit = with LLM_PROVIDER=claude_code the agent edits the thread's git worktree
# directly (file tools only, no shell), the result is reviewed from `git status`, and
# `폐기` throws it away. Edit mode needs a git project and a WORKTREES_ROOT outside `.claude`.
CODE_WORK_MODE=plan
# Limits for one edit run: seconds, agent turns, and a spend cap in US dollars.
AGENT_EDIT_TIMEOUT_SECONDS=600
AGENT_EDIT_MAX_TURNS=40
AGENT_EDIT_MAX_BUDGET_USD=3.0

# Linear Personal API Key for this local PC only. Create it in Linear Settings →
# Security & Access → Personal API keys. Do not commit the generated .env file.
LINEAR_API_KEY=
# Optional defaults for local testing only.
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_TIMEOUT_SECONDS=10

# Root directory for the per-thread markdown context store
# ({THREAD_CONTEXT_ROOT}/{channel_id}/{thread_ts}.md)
THREAD_CONTEXT_ROOT=./thread-context
